# Required before production launch
SHIFTPROOF_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Preview demo authentication. Disable when a real IdP is connected.
SHIFTPROOF_DEMO_AUTH=true
SHIFTPROOF_DEMO_EMAIL=plantmanager@demo.local
SHIFTPROOF_DEMO_PASSWORD=1111

# Managed Postgres. If absent, the cloud UI runs against seeded demo repositories.
DATABASE_URL=

# Evidence storage adapter
SHIFTPROOF_STORAGE_PROVIDER=demo
BLOB_READ_WRITE_TOKEN=

# Notification adapters
EMAIL_PROVIDER=
EMAIL_API_KEY=
PUSH_PROVIDER=
PUSH_API_KEY=

# Optional OpenAI-compatible Shift Commander endpoint
SHIFTPROOF_AI_PROVIDER=none
SHIFTPROOF_AI_BASE_URL=https://api.openai.com/v1
SHIFTPROOF_AI_MODEL=
SHIFTPROOF_AI_API_KEY=

# Generic connector webhook secret
SHIFTPROOF_WEBHOOK_SECRET=replace-me